# Database (Railway provides this automatically when you add Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/db

# Admin password — set this to whatever you want
ADMIN_PASSWORD=changeme
# Cookie signing secret — any long random string
ADMIN_COOKIE_SECRET=please-change-me-to-a-long-random-string

# When the schedule starts (first allowed Sunday).
# Leave as 2026-05-31 for end-of-May start, or change as needed.
SCHEDULE_START_YYYYMMDD=2026-05-31
# How many Sundays to expose in the picker.
SCHEDULE_WEEKS=104

# Resend (https://resend.com) — for email reminders
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Crossway Church <noreply@yourdomain.com>

# httpSMS (https://httpsms.com) — for text reminders
# (Free for up to 200 SMS/month; uses your own Android phone as the gateway)
HTTPSMS_API_KEY=
HTTPSMS_FROM=+15555555555

# Public site URL (used in reminder messages)
SITE_URL=https://yourdomain.com

# Cron protection — used by /api/cron/reminders
CRON_SECRET=please-change-me-to-a-long-random-string

# Brand color (matches existing site)
NEXT_PUBLIC_PRIMARY_COLOR=#568da2
